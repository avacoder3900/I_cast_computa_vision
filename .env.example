# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=icast_cv

# Storage
IMAGE_STORAGE_PATH=data/images

# Camera
DEFAULT_CAMERA_INDEX=0

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins (your Vercel domain + local dev)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# API Key — leave empty to disable auth (dev only)
API_KEY=

# Cloudflare R2 (S3-compatible) — leave all empty to use local storage only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
